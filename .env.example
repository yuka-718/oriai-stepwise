NEXT_PUBLIC_ORI_AI_API_URL=http://127.0.0.1:8788
NEXT_PUBLIC_SITE_URL=https://yuka-718.github.io/oriai-stepwise/
NEXT_PUBLIC_ORIEDITA_DISCOVERY_URL=https://raw.githubusercontent.com/yuka-718/oriai-stepwise/runtime/oriedita-upstream.json
ORIEDITA_UPSTREAM_URL=
ORIEDITA_DISCOVERY_URL=https://raw.githubusercontent.com/yuka-718/oriai-stepwise/runtime/oriedita-upstream.json
ORI_AI_TUNNEL_REGISTRY_REPO=yuka-718/oriai-stepwise

# Backend only. Never commit the real key.
GROQ_API_KEY=
ORI_AI_GROQ_MODEL=qwen/qwen3.6-27b
ORI_AI_LOCAL_HOST=127.0.0.1
ORI_AI_TRUST_PROXY=1
ORI_AI_MAX_CYCLES=10
# The backend default remains compatible with the original site. This frontend
# explicitly requests codex_mcp_stepwise, one fresh Codex process per action.
ORI_AI_DESIGN_MODE=codex_mcp_loop
ORI_AI_CODEX_REASONING_EFFORT=high
ORI_AI_ORIEDITA_STARTUP_TIMEOUT_MS=300000
ORI_AI_STEP_BRANCH_FACTOR=2
ORI_AI_STEP_BEAM_WIDTH=1
# 0 disables per-IP submission limits during validation.
ORI_AI_MAX_JOBS_PER_WINDOW=0
ORI_AI_RATE_WINDOW_MS=21600000
ORI_AI_JOB_TIMEOUT_MS=1200000

# Optional bearer token for the public Oriedita API.
# Generate a long random value and never include it in frontend JavaScript.
ORI_AI_API_TOKEN=
